From: Quoc Trinh <quoc.trinh.fz@renesas.com>
Subject: [PATCH] drp: match platform remove callback with Linux 6.18

Linux 6.18 changed platform_driver.remove to return void. The standalone
RZ/V DRP driver still returns int, which prevents the V4H kernel from
compiling with -Wincompatible-pointer-types.

Upstream-Status: Pending
Signed-off-by: Quoc Trinh <quoc.trinh.fz@renesas.com>
---
 drivers/drp/drp-if.c | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/drivers/drp/drp-if.c b/drivers/drp/drp-if.c
--- a/drivers/drp/drp-if.c
+++ b/drivers/drp/drp-if.c
@@ -135,4 +135,4 @@
 /* A function called from the kernel */
 static int drp_probe(struct platform_device *pdev);
-static int drp_remove(struct platform_device *pdev);
+static void drp_remove(struct platform_device *pdev);
 static int drp_open(struct inode *inode, struct file *file);
@@ -324,10 +324,8 @@ static int drp_probe(struct platform_device *pdev)
     return ret;
 }
 
-static int drp_remove(struct platform_device *pdev)
+static void drp_remove(struct platform_device *pdev)
 {
     drp_unregist_driver();
     drp_unregist_device();
-
-    return 0;
 }
